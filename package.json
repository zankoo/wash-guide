{
  "name": "wash-guide",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/seed-local-catalog.mjs && vite dev --port 3000",
    "build": "node scripts/generate-sw.mjs && vite build",
    "build:api": "cd platform/api && vite build --mode production",
    "build:jobs": "cd platform/jobs && vite build --mode production",
    "start": "node scripts/seed-local-catalog.mjs && vite preview",
    "dev:next": "next dev",
    "build:next": "node scripts/generate-sw.mjs && next build",
    "start:next": "next start",
    "deploy": "pnpm build && cf deploy --prebuilt --mode production",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "data:report": "node scripts/catalog-report.mjs",
    "test:e2e": "playwright test",
    "check:payload": "node scripts/check-payload.mjs",
    "dev:vinext": "node scripts/seed-local-catalog.mjs && vite dev --port 3001",
    "build:vinext": "node scripts/generate-sw.mjs && vite build",
    "start:vinext": "node scripts/seed-local-catalog.mjs && vite preview",
    "deploy:vinext": "vinext-cloudflare deploy"
  },
  "dependencies": {
    "@vinext/cloudflare": "^1.4.0",
    "diff": "^9.0.0",
    "htmlparser2": "^12.0.0",
    "jose": "^6.2.17",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-server-dom-webpack": "^19.3.1",
    "vinext": "^1.4.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-rc.0",
    "@cloudflare/workers-types": "^5.20261117.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitejs/plugin-rsc": "^0.5.39",
    "babel-plugin-react-compiler": "1.0.0",
    "cf": "1.0.0-rc.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "miniflare": "5.20261116.0-beta",
    "oxc-transform-react": "^0.156.0",
    "typescript": "^5",
    "vite": "8.3.0",
    "vitest": "^5.0.4"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "type": "module"
}
